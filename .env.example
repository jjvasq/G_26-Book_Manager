# Plantilla de variables de entorno del sistema.
# Copiar este archivo como .env (que NO se versiona) y completar los valores.

# Cadena de conexión a Supabase (Connect > ORM > DIRECT_URL).
# Se deja el marcador [YOUR-PASSWORD]: la contraseña se toma de la variable
# de entorno SUPABASE_DB_PASSWORD (en Colab, desde los secrets).
DATABASE_URL=postgresql://postgres.<id-proyecto>:[YOUR-PASSWORD]@<host>.pooler.supabase.com:5432/postgres

# URL de la API de cotizaciones del dólar (DolarApi).
API_URL=https://dolarapi.com/v1/dolares
